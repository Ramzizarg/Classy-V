# Neon Postgres — required for orders and admin accounts.
# Get a connection string from https://console.neon.tech
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Optional env fallback login (used only when the email is NOT in backoffice_users).
# Prefer seeding a DB admin: npm run db:seed-admin -- --email you@x.com --password '...'
ADMIN_LOGIN_EMAIL=admin@classyv.local
ADMIN_PASSWORD=classyv
# Used to sign session cookies — change this in production.
ADMIN_SESSION_SECRET=classyv-dev-secret-change-this-in-env

# Vercel Blob — product & hero image uploads. When unset, uploads fall back to
# the local /public/uploads folder (fine for local dev).
BLOB_READ_WRITE_TOKEN=

# Resend — order emails (customer confirmation + new-order alert).
RESEND_API_KEY=
# Where new-order alerts go.
RESEND_ADMIN_EMAIL=
# Must be a mailbox on a domain verified in Resend (SPF + DKIM). Add DMARC too so
# Gmail/Outlook don't file confirmations as spam. Example Cloudflare records:
#   TXT @            v=spf1 include:amazonses.com ~all
#   TXT _dmarc       v=DMARC1; p=none;
#   TXT resend._domainkey   (copy the value from the Resend domain page)
RESEND_FROM_EMAIL=CLASSY V <orders@classy-v.com>
# Public site URL used for images and links inside emails.
NEXT_PUBLIC_SITE_URL=https://classy-v.com

# Meta (Facebook / Instagram) ads — back-office "Ads" page, read-only.
# System user token with the ads_read permission, and the ad account number (with or without act_).
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Optional Graph API version override.
META_GRAPH_VERSION=

# Coming-soon gate — used to hash/verify the visitor password.
COMING_SOON_PASSWORD_PEPPER=classyv-coming-soon-pepper-change-this
COMING_SOON_COOKIE_SECRET=classyv-coming-soon-cookie-change-this

# X-Delivery — server signs in automatically and keeps the session.
# Webhook URL to paste in X-Delivery: https://YOUR-DOMAIN/api/xdelivery/webhook
XDELIVERY_API_KEY=
XDELIVERY_UNIQUE_IDENTIFIER=
XDELIVERY_API_URL=https://app.x-delivery.io
XDELIVERY_EMAIL=
XDELIVERY_PASSWORD=
